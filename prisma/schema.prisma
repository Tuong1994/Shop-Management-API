generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                String          @id @default(uuid())
  email             String
  password          String
  phone             String
  role              Int
  firstName         String?
  lastName          String?
  fullName          String?
  gender            Int?
  birthday          String?
  isDelete          Boolean?
  googleId          String?
  resetToken        String?
  resetTokenExpires BigInt?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  auth              Auth?
  image             Image?
  address           UserAddress?
  permission        UserPermission?
  cart              Cart?
  growths           UserGrowth[]
  bills             Bill[]
  userLoans         UserLoan[]

  @@unique([email, googleId])
  @@index([isDelete, email])
  @@map("user")
}

model UserAddress {
  id            String   @id @default(uuid())
  addressEn     String
  addressVn     String
  fullAddressEn String
  fullAddressVn String
  cityCode      Int
  districtCode  Int
  wardCode      Int
  isDelete      Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId], map: "UserAdress_userId_fkey")
  @@index([isDelete])
  @@map("user_address")
}

model UserPermission {
  id        String   @id @default(uuid())
  create    Boolean
  update    Boolean
  remove    Boolean
  isDelete  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId], map: "UserPermission_userId_fkey")
  @@index([isDelete])
  @@map("user_permission")
}

model Auth {
  id        String   @id @default(uuid())
  token     String   @db.VarChar(3000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId], map: "Auth_userId_fkey")
  @@map("auth")
}

model City {
  id        String   @id @default(uuid())
  nameEn    String
  nameVn    String
  code      Int
  isDelete  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDelete])
  @@map("city")
}

model District {
  id        String   @id @default(uuid())
  nameEn    String
  nameVn    String
  code      Int
  cityCode  Int
  isDelete  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDelete])
  @@map("district")
}

model Ward {
  id           String   @id @default(uuid())
  nameEn       String
  nameVn       String
  code         Int
  districtCode Int
  isDelete     Boolean?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isDelete])
  @@map("ward")
}

model Image {
  id         String    @id @default(uuid())
  path       String
  size       Int
  publicId   String
  isDelete   Boolean?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String?   @unique
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?   @unique
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String?   @unique
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isDelete])
  @@index([userId], map: "Image_userId_fkey")
  @@index([categoryId], map: "Image_categoryId_fkey")
  @@index([productId], map: "Image_productId_fkey")
  @@map("image")
}

model Category {
  id        String    @id @default(uuid())
  nameEn    String
  nameVn    String
  status    Int
  isDelete  Boolean?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  image     Image?
  products  Product[]

  @@index([isDelete])
  @@map("category")
}

model Product {
  id            String     @id @default(uuid())
  nameEn        String
  nameVn        String
  descriptionEn String?    @db.VarChar(3000)
  descriptionVn String?    @db.VarChar(3000)
  unit          Int?
  display       Int?
  cost          Int?
  price         Int
  status        Int
  items         Int?
  boxes         Int?
  amount        Int?
  storageStatus Int?
  type          Int
  supplier      String?
  isNew         Boolean?
  isDelete      Boolean?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  image         Image?
  cartItems     CartItem[]

  @@index([categoryId, isDelete], map: "Product_categoryId_fkey")
  @@map("product")
}

model Cart {
  id        String     @id @default(uuid())
  isDelete  Boolean?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    String
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId])
  @@index([userId], map: "Cart_userId_fkey")
  @@index([isDelete])
  @@map("cart")
}

model CartItem {
  id        String   @id @default(uuid())
  quantity  Int
  isDelete  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cartId    String
  productId String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId], map: "CartItem_cartId_fkey")
  @@index([productId], map: "CartItem_productId_fkey")
  @@map("cart_item")
}

model Growth {
  id        String       @id @default(uuid())
  nameEn    String
  nameVn    String
  cost      Int
  order     Int
  isDelete  Boolean?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  purchases UserGrowth[]

  @@unique([order])
  @@index([isDelete])
  @@map("growth")
}

model UserGrowth {
  id        String   @id @default(uuid())
  userId    String
  growthId  String
  isDelete  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  growth    Growth   @relation(fields: [growthId], references: [id])

  @@index([userId], map: "UserGrowth_userId_fkey")
  @@index([growthId], map: "UserGrowth_growthId_fkey")
  @@map("user_growth")
}

model Bill {
  id        String   @id @default(uuid())
  type      Int
  cost      Int
  isDelete  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Bill_userId_fkey")
  @@map("bill")
}

model Loan {
  id          String     @id @default(uuid())
  type        Int
  cost        Int
  interest    Int
  payment     Int
  termLength  Int
  totalReturn Int
  isDelete    Boolean?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userLoans   UserLoan[]

  @@unique([type])
  @@map("loan")
}

model UserLoan {
  id        String   @id @default(uuid())
  payment   Int
  lateFee   Int
  status    Int
  dueDate   DateTime
  isDelete  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  loanId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([userId], map: "UserLoan_userId_fkey")
  @@index([loanId], map: "UserLoan_loanId_fkey")
  @@map("user_loan")
}
